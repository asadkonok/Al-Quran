{"id": 113, "nameArabic": "سُورَةُ الفَلَقِ", "nameBangla": "আল-ফালাক", "nameEnglish": "Al-Falaq", "meaningBangla": "নিশিভোর", "revelationType": "মাক্কী", "ayahCount": 5, "bismillahPre": true, "ayahs": [{"ayahNumber": 1, "arabic": "قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ", "bangla": "বলুন, আমি আশ্রয় গ্রহণ করছি প্রভাতের পালনকর্তার,"}, {"ayahNumber": 2, "arabic": "مِن شَرِّ مَا خَلَقَ", "bangla": "তিনি যা সৃষ্টি করেছেন, তার অনিষ্ট থেকে,"}, {"ayahNumber": 3, "arabic": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ", "bangla": "অন্ধকার রাত্রির অনিষ্ট থেকে, যখন তা সমাগত হয়,"}, {"ayahNumber": 4, "arabic": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ", "bangla": "গ্রন্থিতে ফুঁৎকার দিয়ে জাদুকারিনীদের অনিষ্ট থেকে"}, {"ayahNumber": 5, "arabic": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ", "bangla": "এবং হিংসুকের অনিষ্ট থেকে যখন সে হিংসা করে।"}]}