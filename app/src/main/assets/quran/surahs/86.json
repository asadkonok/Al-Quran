{"id": 86, "nameArabic": "سُورَةُ الطَّارِقِ", "nameBangla": "আত-তারিক", "nameEnglish": "At-Taariq", "meaningBangla": "রাত্রিকালীন আগমনকারী", "revelationType": "মাক্কী", "ayahCount": 17, "bismillahPre": true, "ayahs": [{"ayahNumber": 1, "arabic": "وَٱلسَّمَآءِ وَٱلطَّارِقِ", "bangla": "শপথ আকাশের এবং রাত্রিতে আগমনকারীর।"}, {"ayahNumber": 2, "arabic": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ", "bangla": "আপনি জানেন, যে রাত্রিতে আসে সেটা কি?"}, {"ayahNumber": 3, "arabic": "ٱلنَّجْمُ ٱلثَّاقِبُ", "bangla": "সেটা এক উজ্জ্বল নক্ষত্র।"}, {"ayahNumber": 4, "arabic": "إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ", "bangla": "প্রত্যেকের উপর একজন তত্ত্বাবধায়ক রয়েছে।"}, {"ayahNumber": 5, "arabic": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ", "bangla": "অতএব, মানুষের দেখা উচিত কি বস্তু থেকে সে সৃজিত হয়েছে।"}, {"ayahNumber": 6, "arabic": "خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ", "bangla": "সে সৃজিত হয়েছে সবেগে স্খলিত পানি থেকে।"}, {"ayahNumber": 7, "arabic": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ", "bangla": "এটা নির্গত হয় মেরুদন্ড ও বক্ষপাজরের মধ্য থেকে।"}, {"ayahNumber": 8, "arabic": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ", "bangla": "নিশ্চয় তিনি তাকে ফিরিয়ে নিতে সক্ষম।"}, {"ayahNumber": 9, "arabic": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ", "bangla": "যেদিন গোপন বিষয়াদি পরীক্ষিত হবে,"}, {"ayahNumber": 10, "arabic": "فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ", "bangla": "সেদিন তার কোন শক্তি থাকবে না এবং সাহায্যকারীও থাকবে না।"}, {"ayahNumber": 11, "arabic": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ", "bangla": "শপথ চক্রশীল আকাশের"}, {"ayahNumber": 12, "arabic": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ", "bangla": "এবং বিদারনশীল পৃথিবীর"}, {"ayahNumber": 13, "arabic": "إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ", "bangla": "নিশ্চয় কোরআন সত্য-মিথ্যার ফয়সালা।"}, {"ayahNumber": 14, "arabic": "وَمَا هُوَ بِٱلْهَزْلِ", "bangla": "এবং এটা উপহাস নয়।"}, {"ayahNumber": 15, "arabic": "إِنَّهُمْ يَكِيدُونَ كَيْدًۭا", "bangla": "তারা ভীষণ চক্রান্ত করে,"}, {"ayahNumber": 16, "arabic": "وَأَكِيدُ كَيْدًۭا", "bangla": "আর আমিও কৌশল করি।"}, {"ayahNumber": 17, "arabic": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا", "bangla": "অতএব, কাফেরদেরকে অবকাশ দিন, তাদেরকে অবকাশ দিন, কিছু দিনের জন্যে।"}]}