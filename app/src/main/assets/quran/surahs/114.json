{"id": 114, "nameArabic": "سُورَةُ النَّاسِ", "nameBangla": "আন-নাস", "nameEnglish": "An-Naas", "meaningBangla": "মানবজাতি", "revelationType": "মাক্কী", "ayahCount": 6, "bismillahPre": true, "ayahs": [{"ayahNumber": 1, "arabic": "قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ", "bangla": "বলুন, আমি আশ্রয় গ্রহণ করিতেছি মানুষের পালনকর্তার,"}, {"ayahNumber": 2, "arabic": "مَلِكِ ٱلنَّاسِ", "bangla": "মানুষের অধিপতির,"}, {"ayahNumber": 3, "arabic": "إِلَٰهِ ٱلنَّاسِ", "bangla": "মানুষের মা’বুদের"}, {"ayahNumber": 4, "arabic": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ", "bangla": "তার অনিষ্ট থেকে, যে কুমন্ত্রণা দেয় ও আত্নগোপন করে,"}, {"ayahNumber": 5, "arabic": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ", "bangla": "যে কুমন্ত্রণা দেয় মানুষের অন্তরে"}, {"ayahNumber": 6, "arabic": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ", "bangla": "জ্বিনের মধ্য থেকে অথবা মানুষের মধ্য থেকে।"}]}